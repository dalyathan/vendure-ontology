<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:eco="http://www.highwayelectronics.com/ontologies/ecommerce.owl#">

    <owl:Ontology rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl">
        <owl:versionIRI rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl/1.8"/> </owl:Ontology>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Agent"/>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Organization">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#HighwayElectronics">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Seller">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentProvider">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Person">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Person"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#User">
      <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Administrator">
      <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#User"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Collection">
      <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Facet">
      <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#FacetValue">
      <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Asset">
      <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

     <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#StockLocation">
         <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>


    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Address"/>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ShippingAddress">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Address"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#BillingAddress">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Address"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#OrderLine"> <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Payment">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/> </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Instamojo">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
    </owl:Class>
     <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Stripe">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
    </owl:Class>
     <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#AuthorizeNet">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
    </owl:Class>
     <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Paypal">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#BankTransferMethod">
        <rdfs:subClassOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
    </owl:Class>

     <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Channel"/>

     <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Fulfillment"/> <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ShippingMethod"> <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
     </owl:Class>

     <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Promotion"/> <owl:Class rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Role"/> <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasCustomer">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hostsSeller">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#HighwayElectronics"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Seller"/>
    </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#managesChannel">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Seller"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Channel"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#managesChannelOnPlatform">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#HighwayElectronics"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Channel"/>
     </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#supportsPaymentProvider">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#HighwayElectronics"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentProvider"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasVariant">
      <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
      <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
    </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#refersToVariant"> <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#OrderLine"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
     </owl:ObjectProperty>


    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#containsItem"> <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#OrderLine"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasShippingAddressDetails">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ShippingAddress"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasBillingAddressDetails">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#BillingAddress"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasPayment">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Payment"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#isPaymentForOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasPayment"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#usesPaymentMethod">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Payment"/>
        <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasDefaultShippingAddress">
      <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer"/>
      <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Address"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasDefaultBillingAddress">
      <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer"/>
      <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Address"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasSavedAddress">
      <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer"/>
      <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Address"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#belongsToChannel">
      <rdfs:domain> <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Asset"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Collection"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Facet"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#FacetValue"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#OrderLine"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ShippingMethod"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#StockLocation"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Promotion"/> <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Role"/> </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
      <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Channel"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#associatedWithUser">
      <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer"/>
      <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#User"/>
    </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasCollection">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Collection"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasFacet">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Facet"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#FacetValue"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasFacetValue">
       <rdfs:domain> <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Collection"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Asset"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#StockLocation"/>
                    <rdf:Description rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Customer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#FacetValue"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasAsset">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/> <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Asset"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#availableAtStockLocation">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#StockLocation"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#isVariantOfProduct">
       <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
       <owl:inverseOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasVariant"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#isValueOfFacet">
       <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
       <owl:inverseOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasFacet"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#managedBySeller">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Channel"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Seller"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#isFulfilledBy">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Fulfillment"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#fulfillsOrder">
       <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
       <owl:inverseOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#isFulfilledBy"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#shipsToAddress">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Fulfillment"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ShippingAddress"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#handledByShippingMethod">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Fulfillment"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ShippingMethod"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#isPartOfOrder"> <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
       <owl:inverseOf rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#containsItem"/>
     </owl:ObjectProperty>


     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasSelectedShippingMethod">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ShippingMethod"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasSelectedPaymentMethod">
       <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Order"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#PaymentMethod"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#includesVariant"> <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Collection"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
     </owl:ObjectProperty>

     <owl:ObjectProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#includesProduct"> <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Collection"/>
       <rdfs:range rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
     </owl:ObjectProperty>


    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasProductName">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasProductDescription">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasSKU">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasCategory">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasOfferPrice">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasCurrency">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasStockQuantity">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasSellerProductId">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.highwayelectronics.com/ontologies/ecommerce.owl#hasOfferState">
        <rdfs:domain rdf:resource="http://www.highwayelectronics.com/ontologies/ecommerce.owl#ProductVariant"/>
